# Everything runs without a model key. Synthetic catalog is included.
APP_PORT=8080
DB_URL=postgresql+psycopg://oplan:oplan_demo_local@db:5432/oplan
LOG_LEVEL=INFO

# Polza.ai; add the key only to your local .env. No key means offline rules.
LLM_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.4-mini
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1500
# Optional: leave empty for model/provider default (better compatibility).
LLM_TEMPERATURE=
