# Everything runs without a model key. Synthetic catalog is included.
APP_PORT=8080
TRAVEL_MODE=local
DB_URL=postgresql+psycopg://oplan:oplan_demo_local@db:5432/oplan
LOG_LEVEL=INFO

# MultiAI; add the key only to your local .env. No key means offline rules.
LLM_BASE_URL=https://multiai.store/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
# Per-call transport ceiling; the whole user turn is bounded to 10/15/20 seconds.
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1500
# Optional: leave empty for model/provider default (better compatibility).
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=none
LLM_STRUCTURED_OUTPUT=1
LLM_TRUST_ENV=1
# Bounded concierge tools and grounded AI explanations (key still required).
AGENT_ENABLED=1
